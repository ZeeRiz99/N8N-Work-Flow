# Replyline environment. Copy with:  .\scripts\new-env.ps1
# That script creates .env and fills every "generate" value with a random secret.
# You type the AI key and Telegram token into .env yourself. Never paste them in chat.

# ---------- App ----------
APP_ENV=development
APP_SECRET_KEY=generate                            # JWT signing
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# ---------- PostgreSQL (one server, two databases, two roles) ----------
POSTGRES_IMAGE_TAG=18.7
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=generate
APP_DB_NAME=replyline
APP_DB_USER=replyline_app
APP_DB_PASSWORD=generate
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=generate
# Built by the backend from the APP_DB_* values above if left empty:
DATABASE_URL=

# ---------- n8n ----------
N8N_IMAGE_TAG=2.47.4                               # n8nio/runners must use the same tag
N8N_ENCRYPTION_KEY=generate                        # back this up separately; losing it makes stored credentials unreadable
N8N_RUNNERS_AUTH_TOKEN=generate
N8N_PUBLIC_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook/rl
BACKEND_URL_FOR_N8N=http://host.docker.internal:8000
N8N_WEBHOOK_SECRET=generate                        # backend -> n8n header secret
SERVICE_API_KEY=generate                           # n8n -> backend (stored hashed in the DB)
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# ---------- Mailpit (dev email catcher) ----------
MAILPIT_IMAGE_TAG=v1.34.0
# Used by the n8n SMTP credential: n8n sends email from inside Docker
SMTP_HOST=mailpit                                  # compose service name, NOT localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@harbor-web.example.com

# ---------- AI ----------
AI_PROVIDER=fake                                   # fake | gemini  (claude, openai added in P5 if keys are supplied)
GEMINI_API_KEY=                                    # type it here yourself; free tier = synthetic data only
GEMINI_MODEL=                                      # chosen in P2 from the models your key can use
GEMINI_MODEL_FALLBACK=
AI_TIMEOUT_SECONDS=30
AI_DAILY_CALL_CAP=500

# ---------- Telegram (test over a system-wide VPN on this network) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALERT_CHAT_ID=

# ---------- Optional ----------
TURNSTILE_SECRET=
SENTRY_DSN=
