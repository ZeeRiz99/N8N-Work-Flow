{
  "id": "rlW1LeadIntake01",
  "name": "RL | W1 | Lead Intake & Orchestration",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## RL | W1 | Lead Intake & Orchestration\n**Trigger:** webhook `lead-created` from the backend (header `X-Webhook-Secret`).\n**Does:** analyze (Gemini, in the backend) -> if High: facts-only alert (email; Telegram once the bot exists) -> write a reply draft into the Approvals queue (the backend skips spam and job seekers) -> log the run.\n**Never sends a reply:** a person approves every draft. Redelivered events are handled once (idempotency keys).",
        "height": 300,
        "width": 620
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000001",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -380
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rl/lead-created",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000002",
      "name": "Lead created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "5f3e2a10-6d2b-4c1a-9e7f-000000000001",
      "credentials": {
        "httpHeaderAuth": {
          "id": "rlCredWebhook001",
          "name": "RL Webhook Secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=__BACKEND_URL__/api/v1/internal/leads/{{ $json.body.data.lead_id }}/analyze",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{ $json.body.request_id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.body.event_id }}:analyze"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000003",
      "name": "Analyze (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "rlCredSvcKey0001",
          "name": "RL Backend Service Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c0ffee00-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.band }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c0ffee00-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.first_delivery }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000004",
      "name": "High priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "url": "=__BACKEND_URL__/api/v1/internal/leads/{{ $('Lead created').item.json.body.data.lead_id }}/alert-summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{ $('Lead created').item.json.body.request_id }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000005",
      "name": "Alert summary (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "rlCredSvcKey0001",
          "name": "RL Backend Service Key"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "__ALERT_EMAIL_FROM__",
        "toEmail": "__ALERT_EMAIL_TO__",
        "subject": "={{ $json.title }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000006",
      "name": "Email the team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        -120
      ],
      "webhookId": "5f3e2a10-6d2b-4c1a-9e7f-000000000002",
      "credentials": {
        "smtp": {
          "id": "rlCredSmtp000001",
          "name": "RL SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=__BACKEND_URL__/api/v1/internal/workflow-runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{ $('Lead created').item.json.body.request_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_key: 'W1', n8n_execution_id: String($execution.id), status: $('Analyze (backend)').item.json.first_delivery ? 'success' : 'skipped', lead_id: $('Lead created').item.json.body.data.lead_id, request_id: $('Lead created').item.json.body.request_id, meta: { band: $('Analyze (backend)').item.json.band, score: $('Analyze (backend)').item.json.score, duplicate_delivery: !$('Analyze (backend)').item.json.first_delivery, event_id: $('Lead created').item.json.body.event_id, draft_id: $('Draft reply (backend)').item.json.draft_id || null, draft_skipped: $('Draft reply (backend)').item.json.skipped || null } }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000007",
      "name": "Log run (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "rlCredSvcKey0001",
          "name": "RL Backend Service Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=__BACKEND_URL__/api/v1/internal/leads/{{ $('Lead created').item.json.body.data.lead_id }}/drafts/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Request-ID",
              "value": "={{ $('Lead created').item.json.body.request_id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $('Lead created').item.json.body.event_id }}:draft"
            }
          ]
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000008",
      "name": "Draft reply (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "rlCredSvcKey0001",
          "name": "RL Backend Service Key"
        }
      }
    }
  ],
