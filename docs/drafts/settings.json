{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "PowerShell(git status)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(pytest:*)",
      "PowerShell(ruff:*)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run test:*)",
      "PowerShell(docker compose ps)",
      "PowerShell(docker compose logs:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(pip install:*)",
      "Bash(npm install:*)",
      "Bash(winget:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down:*)",
      "PowerShell(git push:*)",
      "PowerShell(pip install:*)",
      "PowerShell(npm install:*)",
      "PowerShell(winget:*)",
      "PowerShell(docker compose up:*)",
      "PowerShell(docker compose down:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(Remove-Item -Recurse:*)"
    ]
  }
}
