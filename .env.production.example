# Replyline production settings. Copy to .env.production ON THE SERVER, fill in, never commit.
# Generate every secret with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# scripts/deploy.sh refuses to start while any REPLACE_ME value is left.

# --- site
DOMAIN=REPLACE_ME                 # e.g. app.example.com (an A record must point at the server)
ACME_EMAIL=REPLACE_ME             # Let's Encrypt notices about the certificate
TLS_MODE=                         # leave empty on a server; "internal" only for a local test
HTTP_PORT=80
HTTPS_PORT=443
RELEASE=latest                    # image tag; deploy.sh sets it to the git commit

# --- app
APP_ENV=production
APP_SECRET_KEY=REPLACE_ME         # 48+ random characters
ALLOW_REGISTRATION=false          # invite-only in production (set true for a public demo)
DEMO_ORG_SLUG=harbor-web
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_MINUTE=5

# --- database
POSTGRES_IMAGE_TAG=18.7
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=REPLACE_ME
APP_DB_NAME=replyline
APP_DB_USER=replyline_app
APP_DB_PASSWORD=REPLACE_ME

# --- n8n
N8N_IMAGE_TAG=2.47.4
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=REPLACE_ME
N8N_ENCRYPTION_KEY=REPLACE_ME     # back this up separately: without it n8n credentials are lost
N8N_WEBHOOK_SECRET=REPLACE_ME     # header secret on the backend -> n8n webhooks
SERVICE_API_KEY=REPLACE_ME        # n8n -> backend internal API key
GENERIC_TIMEZONE=UTC
BACKEND_URL_FOR_N8N=http://backend:8000

# --- email (a real SMTP service: Brevo, Resend, Postmark, SES...). See docs/DEPLOYMENT.md (SPF/DKIM/DMARC).
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=REPLACE_ME              # e.g. hello@example.com (a domain you control)
ALERT_EMAIL_TO=REPLACE_ME         # where team alerts, reports and W9 errors go

# --- AI (optional; without a key set AI_PROVIDER=fake and the offline provider runs)
AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_ME         # billing-enabled project for real customer data (§8.8)
GEMINI_DAILY_BUDGET=18            # raise on a paid project
AI_DAILY_CALL_CAP=500

# --- Telegram (optional, later)
TELEGRAM_BOT_TOKEN=
